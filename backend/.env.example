# Copy to .env and fill in. NEVER commit .env to git.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The user's Supabase user UUID (from the users table) — used as user_id
# on task, reminder and conversation rows. Find it in Supabase Table
# Editor > users. Current value lives in backend/.env (never in git).
BOWBOW_USER_ID=
# Activepieces — the only automation engine. One webhook URL per flow,
# copied from each flow's page in Activepieces Cloud (project
# bow-bow-assistant). Leave a flow blank until it is built; the backend
# reports it as not_configured instead of pretending it ran.
ACTIVEPIECES_WEBHOOK_A=
ACTIVEPIECES_WEBHOOK_B=
ACTIVEPIECES_WEBHOOK_C=
ACTIVEPIECES_WEBHOOK_D=
ACTIVEPIECES_WEBHOOK_E=
# Twilio (Phase 11, Announce calls). Trial: only numbers mohamed verified
# in the Twilio Console may be called; TWILIO_ALLOWED_NUMBERS is the
# backend's own allowlist (comma-separated E.164, his own number first).
# The Auth Token goes here and in Vercel env vars — never in chat or git.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ALLOWED_NUMBERS=+917418189588
# Trial only: the Calls API rejects inline Twiml on trial accounts, so
# set this to one of Twilio's template webhook URLs (it speaks Twilio's
# own sample message, not the custom text). Remove it after upgrading —
# then the backend sends the custom inline TwiML above instead.
# TWILIO_CALL_URL=https://webhooks.twilio.com/v1/Voice/Template/voice_text_to_speech
TWILIO_CALL_URL=
